# ==========================================================================
# Услуги · Махачкала — Apache (этап 3). Кладётся в корень сайта рядом с index.html
# ==========================================================================
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS: включить после выпуска сертификата (Let's Encrypt / .рф) -----
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # --- Короткие ссылки для QR: точка расклейки → главная с UTM-метками ----
  # (marketing-brief.md, раздел 10.3; advertising-plan.md, раздел 5.2)
  # QR на листовке ведёт на https://<короткий-домен>/<слаг>, дальше 301.
  # utm_content = номер партии листовок: a4_p1 — первая партия формата А4.
  RewriteRule ^oktyabr$    https://uslugi-mahachkala.ru/?utm_source=flyer&utm_medium=offline&utm_campaign=oktyabrskiy&utm_content=a4_p1 [R=301,L]
  RewriteRule ^sportiv$    https://uslugi-mahachkala.ru/?utm_source=flyer&utm_medium=offline&utm_campaign=sportivnyy&utm_content=a4_p1 [R=301,L]
  RewriteRule ^kirovskiy$  https://uslugi-mahachkala.ru/?utm_source=flyer&utm_medium=offline&utm_campaign=kirovskiy&utm_content=a4_p1 [R=301,L]
  # Новая точка расклейки: добавить строку по образцу (слаг — латиница, ≤12 знаков,
  # utm_campaign — латиница точки, utm_content — номер партии листовок).

  # Одна версия адреса: без www → на основной домен (включить, когда куплен)
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# --- Сжатие: страницы, стили, скрипты, шрифты -----------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript \
    application/javascript application/json image/svg+xml \
    font/woff2 application/font-woff2
</IfModule>

# --- Кэширование: несменяемые ресурсы ------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css            "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2          "access plus 1 year"
  ExpiresByType image/svg+xml       "access plus 1 month"
  ExpiresByType text/html           "access plus 0 seconds"
</IfModule>

<FilesMatch "\.(env|log|sql|md)$">
  Require all denied
</FilesMatch>
